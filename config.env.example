# Email reports (optional - leave the whole block out to disable email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=homebrew@your-domain.com
SMTP_PASSWORD=your-password
MAIL_TO=you@example.com

# Webhook notifications (optional)
# WEBHOOK_TYPE is one of ntfy, slack, discord, json - inferred from the URL if omitted.
# WEBHOOK_URL=https://ntfy.sh/your-secret-topic
# WEBHOOK_TYPE=ntfy
